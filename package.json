{
  "name": "demo-overlay",
  "version": "1.0.0",
  "description": "macOS Electron overlay checklist app for live demos",
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc",
    "build:renderer": "esbuild src/index.tsx --bundle --outfile=dist/src/index.js --platform=browser --format=esm --external:electron",
    "watch": "tsc -w",
    "dist": "electron-builder",
    "clean": "rm -rf dist"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "electron": "^40.0.0",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.19.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "build": {
    "appId": "com.demo-overlay.app",
    "productName": "DemoOverlay",
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "files": [
      "dist/**/*",
      "src/**/*",
      "assets/**/*",
      "index.html",
      "package.json",
      "sample/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
